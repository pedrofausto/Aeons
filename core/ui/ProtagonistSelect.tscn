[gd_scene format=3]

[ext_resource type="Script" path="res://core/ui/ProtagonistSelect.gd" id="1_sel"]
[ext_resource type="Script" path="res://core/ui/StormBackdrop.gd" id="2_storm"]

[node name="ProtagonistSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_sel")

[node name="StormBackdrop" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
