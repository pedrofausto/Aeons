; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aeon"
config/description="RPG estratégico (Vertical Slice: Vales de Nanlu)."
config/version="0.1.0"
run/main_scene="res://core/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/autoloads/EventBus.gd"
WorldState="*res://core/autoloads/WorldState.gd"
EssenceState="*res://core/autoloads/EssenceState.gd"
SaveSystem="*res://core/autoloads/SaveSystem.gd"
Dialogic="*uid://ds2q0uclmolvu"

[debug]

gdscript/warnings/untyped_declaration=1

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"a_agua_de_carcassonne": "res://eras/act_02_occitania/dialogues/a_agua_de_carcassonne.dtl",
