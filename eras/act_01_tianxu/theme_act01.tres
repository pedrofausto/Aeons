[gd_resource type="Theme" format=3]

[sub_resource type="StyleBoxFlat" id="panel"]
content_margin_left = 8
content_margin_top = 6
content_margin_right = 8
content_margin_bottom = 6
bg_color = Color(0.1, 0.09, 0.07, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.79, 0.64, 0.36, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="button"]
content_margin_left = 7
content_margin_top = 4
content_margin_right = 7
content_margin_bottom = 4
bg_color = Color(0.32, 0.12, 0.1, 1)
border_width_bottom = 2
border_color = Color(0.79, 0.64, 0.36, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="button_hover"]
content_margin_left = 7
content_margin_top = 4
content_margin_right = 7
content_margin_bottom = 4
bg_color = Color(0.48, 0.18, 0.13, 1)
border_width_bottom = 2
border_color = Color(0.79, 0.64, 0.36, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[resource]
default_font_size = 9
Button/colors/font_color = Color(0.95, 0.9, 0.78, 1)
Button/styles/disabled = SubResource("button")
Button/styles/hover = SubResource("button_hover")
Button/styles/normal = SubResource("button")
Button/styles/pressed = SubResource("button_hover")
Label/colors/font_color = Color(0.95, 0.9, 0.78, 1)
PanelContainer/styles/panel = SubResource("panel")
